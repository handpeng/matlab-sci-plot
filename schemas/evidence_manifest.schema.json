{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matlab-sci-plot/evidence-manifest/1.0",
  "title": "Evidence/Provenance Manifest",
  "type": "object",
  "required": ["manifest_type", "manifest_version", "skill_version", "contract_versions", "outputs"],
  "properties": {
    "manifest_type": {"const": "figure_evidence"},
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "skill_version": {"type": "string"},
    "contract_versions": {"type": "object"},
    "source_data": {"type": "object"},
    "matlab_version": {"type": ["string", "null"]},
    "candidate_sha": {"type": "string"},
    "qualification_timestamp": {"type": "string"},
    "renderer_identity": {"type": "array", "items": {"type": "string"}},
    "family_id": {"type": "string"},
    "typography": {
      "type": "object",
      "required": ["contains_cjk", "requested_font", "resolved_font", "font_policy_id", "policy_version", "resolution"],
      "properties": {
        "contains_cjk": {"type": "boolean"},
        "requested_font": {"type": "string", "minLength": 1},
        "resolved_font": {"type": "string", "minLength": 1},
        "font_policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "resolution": {"enum": ["requested_english", "requested_cjk", "fallback_cjk"]}
      },
      "additionalProperties": false
    },
    "style_profile": {"type": "string"},
    "final_dimensions": {"type": "object"},
    "palette": {"type": "object"},
    "transformations": {"type": "array"},
    "exclusions": {"type": "array"},
    "uncertainty": {"type": ["object", "null"]},
    "selected_candidate": {"type": ["string", "null"]},
    "review_result": {"type": "object"},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["path"]}}
  },
  "additionalProperties": false
}
