{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/handpeng/matlab-sci-plot/schemas/figure-contract/1.0",
  "title": "Figure Contract",
  "type": "object",
  "required": ["contract_type", "contract_version", "purpose", "claim", "data_bindings", "provenance"],
  "properties": {
    "contract_type": {"const": "figure_contract"},
    "contract_version": {"const": "1.0"},
    "purpose": {"type": "string"},
    "claim": {"type": "object", "required": ["primary"], "properties": {"primary": {"type": "string"}, "secondary": {"$ref": "#/$defs/strings"}, "n": {"$ref": "#/$defs/count"}, "n_common": {"$ref": "#/$defs/count"}, "n_by_model": {"$ref": "#/$defs/counts"}}, "additionalProperties": false},
    "data_bindings": {"type": "object"},
    "roles": {"$ref": "#/$defs/textMap"},
    "labels": {"$ref": "#/$defs/textMap"},
    "units": {"$ref": "#/$defs/textMap"},
    "communication_task": {"type": "string"},
    "panel_label": {"type": "string"},
    "panels": {"type": "array", "minItems": 1, "items": {"$ref": "#"}},
    "layout": {"type": "string"},
    "panel_count": {"type": "integer", "minimum": 1},
    "final_size": {"type": "object", "properties": {"width_mm": {"type": "number", "exclusiveMinimum": 0}, "height_mm": {"type": "number", "exclusiveMinimum": 0}}, "required": ["width_mm", "height_mm"], "additionalProperties": false},
    "required_unit_roles": {"$ref": "#/$defs/strings"},
    "scale_policy": {"type": "string"},
    "scale_disclosure": {"type": "string"},
    "comparison_policy": {"type": "string"},
    "n": {"$ref": "#/$defs/count"},
    "n_common": {"$ref": "#/$defs/count"},
    "n_by_model": {"$ref": "#/$defs/counts"},
    "sample_size_required": {"type": "boolean"},
    "grouping_required": {"type": "boolean"},
    "category_count": {"$ref": "#/$defs/count"},
    "max_categories": {"type": "integer", "minimum": 1},
    "palette_id": {"type": "string"},
    "encoding": {"type": "string"},
    "zero_baseline": {"type": "boolean"},
    "axis_limits": {"type": "object", "properties": {"y": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}, "additionalProperties": false},
    "dual_y_axis": {"type": "boolean"},
    "dual_y_axis_justification": {"type": "string"},
    "uncertainty_requested": {"type": "boolean"},
    "requested_layers": {"type": "object", "properties": {"uncertainty": {"type": "boolean"}}, "additionalProperties": false},
    "uncertainty_label": {"type": "string"},
    "analysis_authorization": {"type": "object", "properties": {"class_c": {"type": "boolean"}, "operations": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
    "domain_pattern": {"type": "string"},
    "sample": {"type": "object"},
    "missing_data": {"type": "object"},
    "exclusions": {"type": "array"},
    "transformations": {"type": "array"},
    "uncertainty": {"type": ["object", "null"]},
    "target_profile": {"type": ["string", "null"]},
    "final_width": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "visual_priorities": {"type": "array", "items": {"type": "string"}},
    "prohibited_encodings": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "required": ["source_id"], "properties": {"source_id": {"type": "string"}, "source_hash": {"type": "string"}}, "additionalProperties": true}
  },
  "additionalProperties": false,
  "anyOf": [
    {"properties": {"data_bindings": {"minProperties": 1}}},
    {"required": ["panels"]}
  ],
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "textMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "count": {"type": "integer", "minimum": 0},
    "counts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}}
  }
}
